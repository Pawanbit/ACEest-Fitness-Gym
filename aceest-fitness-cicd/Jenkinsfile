pipeline {
    agent any
    options {
        timestamps()
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '20'))
    }
    environment {
        APP_NAME = 'aceest-fitness'
        IMAGE_REPO = 'pawanbit/aceest-fitness'
        K8S_NAMESPACE = 'aceest'
        SONAR_PROJECT_KEY = 'aceest-fitness'
        VENV = '.venv'
    }
    stages {
        stage('Checkout') {
            steps { checkout scm }
        }
        stage('Dependencies') {
            steps {
                sh '''#!/bin/sh
                    python3 -m venv "$VENV"
                    "$VENV/bin/python" -m pip install --upgrade pip
                    "$VENV/bin/pip" install -r requirements-dev.txt
                '''
            }
        }
        stage('Pytest') {
            steps {
                sh '''#!/bin/sh
                    mkdir -p reports
                    "$VENV/bin/pytest" --junitxml=reports/junit.xml \
                      --cov=ACEest_Fitness --cov=fitness_core \
                      --cov-report=xml:reports/coverage.xml \
                      --cov-report=term-missing
                '''
            }
            post {
                always {
                    junit allowEmptyResults: false, testResults: 'reports/junit.xml'
                    archiveArtifacts allowEmptyArchive: true, artifacts: 'reports/coverage.xml'
                }
            }
        }
        stage('SonarQube Analysis') {
            steps {
                withSonarQubeEnv('SonarQube') {
                    sh '''#!/bin/sh
                        sonar-scanner \
                          -Dsonar.projectKey="$SONAR_PROJECT_KEY" \
                          -Dsonar.python.coverage.reportPaths=reports/coverage.xml
                    '''
                }
            }
        }
        stage('Quality Gate') {
            steps {
                timeout(time: 10, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }
        stage('Docker Build') {
            steps {
                script {
                    env.IMAGE_TAG = sh(script: 'git rev-parse --short=12 HEAD', returnStdout: true).trim()
                }
                sh 'docker build --pull -t "$IMAGE_REPO:$IMAGE_TAG" -t "$IMAGE_REPO:latest" .'
            }
        }
        stage('Docker Push') {
            when { branch 'main' }
            steps {
                withCredentials([usernamePassword(credentialsId: 'dockerhub-credentials', usernameVariable: 'DOCKER_USER', passwordVariable: 'DOCKER_TOKEN')]) {
                    sh '''#!/bin/sh
                        echo "$DOCKER_TOKEN" | docker login -u "$DOCKER_USER" --password-stdin
                        docker push "$IMAGE_REPO:$IMAGE_TAG"
                        docker push "$IMAGE_REPO:latest"
                        docker logout
                    '''
                }
            }
        }
        stage('Deploy to Kubernetes') {
            when { branch 'main' }
            steps {
                withCredentials([file(credentialsId: 'kubeconfig-aceest', variable: 'KUBECONFIG')]) {
                    sh '''#!/bin/sh
                        kubectl apply -f k8s/namespace.yaml
                        kubectl apply -f k8s/service.yaml
                        kubectl apply -f k8s/deployment.yaml
                        kubectl -n "$K8S_NAMESPACE" set image deployment/aceest-fitness \
                          aceest-fitness="$IMAGE_REPO:$IMAGE_TAG"
                        kubectl -n "$K8S_NAMESPACE" rollout status deployment/aceest-fitness --timeout=180s
                    '''
                }
            }
        }
        stage('Smoke Test') {
            when { branch 'main' }
            steps {
                withCredentials([file(credentialsId: 'kubeconfig-aceest', variable: 'KUBECONFIG')]) {
                    sh 'kubectl -n "$K8S_NAMESPACE" get deployment,pods,service'
                }
            }
        }
    }
    post {
        always { archiveArtifacts allowEmptyArchive: true, artifacts: 'reports/**' }
        success { echo "CI/CD pipeline completed successfully for ${env.BUILD_TAG}." }
        failure { echo "Pipeline failed; publish and deployment stages were blocked." }
        cleanup { deleteDir() }
    }
}
